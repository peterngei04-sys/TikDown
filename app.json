{
  "expo": {
    "name": "TikDown",
    "slug": "TikDown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TikDown.png",
    "scheme": "tikdown",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/TikDown.png"
    },

    "android": {
      "package": "com.cephas399.tikdown",
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/TikDown.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-media-library"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "2acd3c4c-0655-4533-9ee4-c83eb66b9048"
      }
    }
  }
}
